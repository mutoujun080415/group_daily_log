{
  "name": "group_daily_log",
  "display_name": "群日报 · Daily Log",
  "version": "2.0.1",
  "summary": "把群聊一天的内容整理成一张日报长图海报",
  "description": "统计群聊消息量、参与人数、字数、表情与 24 小时活跃度，调用模型提炼今日话题、群友图鉴、今日名言与数据小结，最后用 Pillow 渲染成一张可直接发群的长图；支持每天定时投递、/日报 手动补发，并自带一个挂到主程序 HTTP 服务器的独立页面（选群、选日期、历史画廊、海报预览、封面替换），不依赖官方 Plugin UI。",
  "author": "MoFox Studio",
  "license": "MIT",
  "maintainers": [
    "MoFox Studio"
  ],
  "categories": [
    "tool"
  ],
  "tags": [
    "daily-log",
    "summary",
    "poster",
    "group",
    "report",
    "webui"
  ],
  "dependencies": {
    "plugins": [],
    "components": []
  },
  "include": [
    {
      "component_type": "config",
      "component_name": "config",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "service",
      "component_name": "daily_log_service",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "command",
      "component_name": "日报",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "router",
      "component_name": "daily_log_webui",
      "dependencies": [],
      "enabled": true
    }
  ],
  "entry_point": "plugin.py",
  "api_version": {
    "llm_api": "1.1.0",
    "log_api": "1.0.0",
    "message_api": "1.0.0",
    "send_api": "1.1.0"
  },
  "min_core_version": "1.3.0-alpha.0",
  "python_dependencies": [
    "pillow>=10.0.0"
  ],
  "dependencies_required": true,
  "repository_url": "https://github.com/mutoujun080415/group_daily_log",
  "homepage": "https://github.com/mutoujun080415/group_daily_log",
  "icon_url": "https://github.com/mutoujun080415/group_daily_log/raw/main/icon.png"
}
